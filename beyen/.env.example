# Copy to beyen/.env and fill in. Never commit the real .env.

# Local development only — docker-compose sets this itself.
DATABASE_URL=postgresql://comis_user:your-password@localhost:5432/comis_db

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production   (development prints reset codes to the console)
APP_ENV=development

# First System Admin — created on first start if no active admin exists.
# Remove ADMIN_PASSWORD after the account is created and change it in the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Must match the OAuth client ID the frontend uses (defaults to the current one)
# GOOGLE_CLIENT_ID=

# Where password-reset links point
FRONTEND_URL=http://localhost:5173

# SMTP for password-reset emails (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# JSON list; only needed when the frontend is served from a different origin
# CORS_ORIGINS=["http://localhost:5173"]

# Orange Money payouts — NOT ACTIVE (placeholder). Leave empty; nothing reads these yet.
# ORANGE_MONEY_CLIENT_ID=
# ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_MERCHANT_KEY=
