# Copy to beyen/.env and fill in. Never commit the real .env.

# Local development only — docker-compose sets this itself.
DATABASE_URL=postgresql://comis_user:your-password@localhost:5432/comis_db

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production   (development prints reset codes to the console)
APP_ENV=development

# First System Admin — created on first start if no active admin exists.
# Remove ADMIN_PASSWORD after the account is created and change it in the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Must match the OAuth client ID the frontend uses (defaults to the current one)
# GOOGLE_CLIENT_ID=

# Where password-reset links point
FRONTEND_URL=http://localhost:5173

# SMTP for password-reset emails (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# JSON list; only needed when the frontend is served from a different origin
# CORS_ORIGINS=["http://localhost:5173"]

# Orange Money payouts — NOT ACTIVE (placeholder). Leave empty; nothing reads these yet.
# ORANGE_MONEY_CLIENT_ID=
# ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_MERCHANT_KEY=

# Reading the NIN / passport number from ID photos (an admin reviews every document anyway)
#   local    = free offline engine: pip install rapidocr_onnxruntime
#   ocrspace = OCR.space cloud API (sends the photo to them), needs OCR_SPACE_API_KEY
#   none     = members type the number
OCR_PROVIDER=local
# OCR_SPACE_API_KEY=

# Photo/video hosting. Empty = save on the server's disk (beyen/media)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Shared rate limiting. Empty = in-memory (per process)
# REDIS_URL=redis://default:<password>@<host>:<port>

# Text members (phone-verified, max 1 a day) when a new post matches what they need or sell
# MARKET_ALERT_SMS=true

# "For you" feed weights (see Market Moderation -> Feed Stats). Defaults shown.
# FEED_W_MATCH=5
# FEED_W_NEARBY=2
# FEED_W_FRESH=1
# FEED_W_POPULAR=0.5
# FEED_W_TRUSTED=1
